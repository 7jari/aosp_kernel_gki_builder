KERNEL_SOURCE=https://github.com/samsung-sm6225-dev/android_kernel_samsung_a05s
KERNEL_SOURCE_BRANCH=android13-5.15
KERNEL_CONFIG=vendor/m269-gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

ENABLE_CLANG=true
USE_AOSP_CLANG=false
AOSP_CLANG_SYSTEM=linux-x86
AOSP_CLANG_BRANCH=main
AOSP_CLANG_VERSION=stable
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/17.0.0-20230725-release/Clang-17.0.0-20230725.tar.gz
CUSTOM_CLANG_BRANCH=
USE_UBUNTU_CLANG=true

ENABLE_GCC=true
USE_AOSP_GCC=false
ENABLE_AOSP_GCC_ARM64=false
ENABLE_AOSP_GCC_ARM32=false
AOSP_GCC_SYSTEM=linux-x86
AOSP_GCC_ARM64_VERSION=aarch64-linux-android-4.9
AOSP_GCC_ARM32_VERSION=arm-linux-androideabi-4.9
AOSP_GCC_ANDROID_VERSION=14.0.0
AOSP_GCC_RELEASE=r0.1
ENABLE_CUSTOM_GCC=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=https://github.com/mvaisakh/gcc-arm64.git
CUSTOM_GCC_64_BRANCH=gcc-master
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=https://github.com/mvaisakh/gcc-arm.git
CUSTOM_GCC_32_BRANCH=gcc-master
CUSTOM_GCC_32_BIN=arm-linux-androideabi-
USE_UBUNTU_GCC=true
ENABLE_UBUNTU_GCC_64=true
ENABLE_UBUNTU_GCC_32=true

ENABLE_KERNELSU=false
KERNELSU_INSTALLER=https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh
KERNELSU_TAG=main
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
BUILD_KERNELSU_BOOT_IMG=false
KERNELSU_SOURCE_BOOT_IMAGE=

DISABLE-LTO=true
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
ENABLE_CCACHE=false
NEED_DTBO=false
BUILDER_HOST=ci

TC_CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu- LLVM=1 LLVM_IAS=1
EXTRA_CMDS=LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump READELF=llvm-readelf STRIP=llvm-strip
